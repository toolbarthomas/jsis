{
  "name": "@toolbarthomas/jsis",
  "version": "0.2.0",
  "description": "Javascript Signed Integer Storage",
  "type": "module",
  "types": "./src/index.ts",
  "main": "./dist/index.min.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "main": "./dist/index.js"
    }
  },
  "files": [
    "./dist/index.js",
    "./dist/index.min.js",
    "./src/index.ts",
    "./src/types.d.ts",
    "./tests/",
    "./node/",
    "./tsconfig.json"
  ],
  "scripts": {
    "build": "node ./node/build.mjs --minify && node ./node/build.mjs",
    "predev": "npm run build",
    "pretest": "tsc --noEmit",
    "test": "node ./node/test.mjs && node --test dist/tests/*.mjs",
    "dev": "node ./dist/index.js"
  },
  "author": "Thomas van der Velde <contact@toolbarthomas.net>",
