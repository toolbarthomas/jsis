{
  "name": "@toolbarthomas/jsis",
  "version": "0.1.1",
  "description": "Javascript Signed Integer Storage",
  "type": "module",
  "types": "./src/index.ts",
  "main": "./dist/index.min.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "main": "./dist/index.js"
    }
  },
  "files": [
    "./dist/index.js",
    "./dist/index.min.js",
    "./src/index.ts",
    "./src/types.d.ts",
    "./tests/",
    "./node/",
    "./tsconfig.json"
  ],
  "scripts": {
    "build": "node ./node/build.mjs --minify && node ./node/build.mjs",
    "predev": "npm run build",
    "pretest": "tsc --noEmit",
    "test": "node ./node/test.mjs",
    "posttest": "node node_modules/mocha/bin/mocha.js \"dist/tests/*.test.cjs\"",
    "dev": "node ./dist/index.js"
  },
  "author": "Thomas van der Velde <contact@toolbarthomas.net>",
  "license": "MIT",
  "devDependencies": {
    "@toolbarthomas/argumentje": "^0.2.0",
    "esbuild": "^0.25.12",
    "glob": "^11.0.3",
    "mocha": "^11.7.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}